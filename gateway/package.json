{
  "name": "kodechirp-gateway",
  "version": "2.0.0",
  "description": "KodeChirp API Gateway — Node.js + Express + Socket.IO",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --watch src src/server.js",
    "test": "jest --coverage",
    "generate-missing-testcases": "node src/scripts/generate-missing-testcases.js",
    "generate-missing-testcases:dry": "node src/scripts/generate-missing-testcases.js --dry-run",
    "import:aptitude": "node src/scripts/import_aptitude.js",
    "import:aptitude:dry": "node src/scripts/import_aptitude.js --dry-run",
    "import:leetcode": "node src/scripts/import_leetcode.js",
    "import:leetcode:dry": "node src/scripts/import_leetcode.js --dry-run",
    "review:unpublished": "node src/scripts/review_unpublished.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.1.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.1",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "node-fetch": "^2.7.0",
    "pg": "^8.11.3",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "resend": "^6.37.0",
    "socket.io": "^4.7.4",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^6.3.3"
  },
  "overrides": {
    "js-yaml": "^4.3.2",
    "body-parser": "^1.20.9"
  }
}
